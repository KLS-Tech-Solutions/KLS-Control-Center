# ---------------------------------------------------------------------------
# Backend. API_BASE_URL is server-only — the browser never talks to FastAPI
# directly, it goes through /api/proxy so the admin JWT stays in an httpOnly
# cookie. An admin token is a higher-value target than a student's.
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1

# Set true in every deployed environment.
COOKIE_SECURE=false

# Where the student app lives — used for certificate verification links.
NEXT_PUBLIC_ACADEMY_URL=http://localhost:3000
